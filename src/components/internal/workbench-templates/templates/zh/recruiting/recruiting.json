{
  "appConfig": {
    "appId": "recruiting-app",
    "logo": "/logo.png",
    "theme": "recruiting",
    "layout": {
      "type": "industry",
      "headerActions": ["switchIndustry", "userProfile", "help"],
      "menuPosition": "mix"
    },
    "navigation": {
      "items": [
        {
          "key": "dashboard",
          "path": "/workbench/recruiting/dashboard",
          "title": "工作台",
          "icon": "dashboard",
          "linkedPage": "dashboard",
          "pageParameters": {
            "view": "overview",
            "period": "month",
            "showStats": true
          }
        },
        {
          "key": "candidates",
          "path": "/workbench/recruiting/candidates",
          "title": "候选人搜索",
          "icon": "search",
          "linkedPage": "candidates",
          "pageParameters": {
            "status": "active",
            "source": "all",
            "pageSize": 20
          }
        },
        {
          "key": "clients",
          "path": "/workbench/recruiting/clients",
          "title": "客户管理",
          "icon": "team",
          "linkedPage": "clients",
          "pageParameters": {
            "type": "active",
            "sortBy": "created_at",
            "includeArchived": false
          }
        },
        {
          "key": "jobs",
          "path": "/workbench/recruiting/jobs",
          "title": "职位管理",
          "icon": "solution",
          "linkedPage": "jobs",
          "pageParameters": {
            "status": "open",
            "category": "all",
            "urgency": "high"
          }
        },
        {
          "key": "reports",
          "path": "/workbench/recruiting/reports",
          "title": "报表分析",
          "icon": "bar-chart",
          "linkedPage": "reports",
          "pageParameters": {
            "reportType": "recruiting",
            "dateRange": "last_30_days",
            "groupBy": "week",
            "includeSubMetrics": true
          }
        }
      ]
    }
  },
  "pages": {
    "dashboard": {
      "title": "猎头工作台",
      "layout": "fluid",
      "components": [
        {
          "type": "StatisticGroup",
          "id": "dashboardStats",
          "grid": { "cols": 4 },
          "dataSource": {
            "type": "dataset",
            "datasetId": "ds_001",
            "params": {
              "filter": "date >= '2024-04-01'",
              "limit": 4,
              "outputFields": ["key", "title", "value", "icon", "trend"]
            }
          },
          "mockData": [
            {
              "key": "candidates",
              "title": "今日候选人",
              "value": 18,
              "icon": "user",
              "trend": {
                "value": 12,
                "type": "up",
                "suffix": "%",
                "status": "success",
                "description": "较上周"
              }
            },
            {
              "key": "jobs",
              "title": "开放职位",
              "value": 24,
              "icon": "solution",
              "trend": {
                "value": 5,
                "type": "up",
                "suffix": "个",
                "status": "success",
                "description": "本周新增"
              }
            },
            {
              "key": "clients",
              "title": "活跃客户",
              "value": 12,
              "icon": "team",
              "trend": {
                "value": 8,
                "type": "up",
                "suffix": "%",
                "status": "success",
                "description": "较上月"
              }
            },
            {
              "key": "hires",
              "title": "本月入职",
              "value": 6,
              "icon": "check-circle",
              "trend": {
                "value": 3,
                "suffix": "人",
                "type": "up",
                "status": "success",
                "description": "待确认"
              }
            }
          ]
        },
        {
          "type": "Container",
          "id": "listGroup",
          "props": {
            "layout": "grid",
            "cols": [1, 1],
            "gutter": 16
          },
          "children": [
            {
              "type": "DataGridCard",
              "id": "candidateList",
              "props": {
                "title": "热门候选人",
                "pagination": false,
                "rowKey": "id",
                "columns": [
                  {
                    "title": "姓名",
                    "dataIndex": "name",
                    "key": "name",
                    "primary": true,
                    "searchable": true
                  },
                  {
                    "title": "职位",
                    "dataIndex": "position",
                    "key": "position",
                    "secondary": true,
                    "searchable": true
                  },
                  {
                    "title": "匹配度",
                    "dataIndex": "matchRate",
                    "key": "matchRate",
                    "render": {
                      "type": "Progress",
                      "props": {
                        "status": "matchRate >= 90 ? 'success' : matchRate >= 70 ? 'normal' : 'exception'",
                        "showInfo": true,
                        "size": "small"
                      }
                    }
                  },
                  {
                    "title": "状态",
                    "dataIndex": "status",
                    "key": "status",
                    "render": {
                      "type": "Tag",
                      "props": {
                        "color": {
                          "interviewing": "blue",
                          "matching": "orange",
                          "offered": "green",
                          "default": "default"
                        }
                      },
                      "text": {
                        "interviewing": "面试中",
                        "matching": "匹配中",
                        "offered": "已发offer",
                        "default": "待处理"
                      }
                    }
                  }
                ]
              },
              "dataSource": {
                "type": "dataset",
                "datasetId": "ds_002",
                "params": {
                  "filter": "status in ['interviewing', 'matching', 'offered']",
                  "limit": 5,
                  "offset": 0,
                  "outputFields": ["id", "name", "position", "matchRate", "status"]
                }
              },
              "mockData": [
                { "id": 1, "name": "张小明", "position": "高级前端工程师", "matchRate": 92, "status": "interviewing" },
                { "id": 2, "name": "李四", "position": "产品经理", "matchRate": 85, "status": "matching" },
                { "id": 3, "name": "王五", "position": "UX设计师", "matchRate": 78, "status": "offered" },
                { "id": 4, "name": "赵六", "position": "全栈工程师", "matchRate": 95, "status": "pending" }
              ]
            },
            {
              "type": "DataGridCard",
              "id": "jobList",
              "props": {
                "title": "招聘职位",
                "pagination": false,
                "rowKey": "id",
                "columns": [
                  {
                    "title": "职位名称",
                    "dataIndex": "title",
                    "key": "title",
                    "primary": true,
                    "searchable": true
                  },
                  {
                    "title": "客户公司",
                    "dataIndex": "client",
                    "key": "client",
                    "secondary": true,
                    "searchable": true
                  },
                  {
                    "title": "招聘人数",
                    "dataIndex": "count",
                    "key": "count"
                  },
                  {
                    "title": "状态",
                    "dataIndex": "status",
                    "key": "status",
                    "render": {
                      "type": "Tag",
                      "props": {
                        "color": {
                          "active": "green",
                          "pending": "orange",
                          "closed": "red"
                        }
                      },
                      "text": {
                        "active": "招聘中",
                        "pending": "待处理",
                        "closed": "已关闭"
                      }
                    }
                  }
                ]
              },
              "dataSource": {
                "type": "dataset",
                "datasetId": "ds_003",
                "params": {
                  "filter": "status != 'closed'",
                  "limit": 5,
                  "offset": 0,
                  "outputFields": ["id", "title", "client", "count", "status", "candidates"]
                }
              },
              "mockData": [
                { "id": 1, "title": "高级前端工程师", "client": "腾讯科技", "count": 2, "status": "active", "candidates": 8 },
                { "id": 2, "title": "产品经理", "client": "阿里巴巴", "count": 1, "status": "active", "candidates": 5 },
                { "id": 3, "title": "UX设计师", "client": "字节跳动", "count": 3, "status": "pending", "candidates": 10 },
                { "id": 4, "title": "全栈工程师", "client": "百度", "count": 2, "status": "closed", "candidates": 0 }
              ]
            }
          ]
        },
        {
          "type": "Tabs",
          "id": "recruitingProgress",
          "props": {
            "defaultActiveKey": "all",
            "type": "card",
            "size": "large"
          },
          "children": [
            {
              "type": "TabPane",
              "props": {
                "key": "all",
                "label": "全部进度"
              },
              "component": {
                "type": "Chart",
                "id": "allProgress",
                "dataSource": {
                  "type": "dataset",  
                  "datasetId": "ds_005",
                  "params": {
                    "filter": "type = 'all'",
                    "limit": 100,
                    "outputFields": ["stage", "count"]
                  }
                },
                "mockData": [
                  { "stage": "简历筛选", "count": 120 },
                  { "stage": "初试", "count": 80 },
                  { "stage": "复试", "count": 45 },
                  { "stage": "终面", "count": 25 },
                  { "stage": "Offer", "count": 15 },
                  { "stage": "入职", "count": 8 }
                ],
                "props": {
                  "chartType": "column",
                  "title": "招聘进度统计",
                  "xField": "stage",
                  "yField": "count",
                  "height": 300,
                  "meta": {
                    "stage": { "alias": "阶段" },
                    "count": { "alias": "数量" }
                  },
                  "label": {
                    "text": "count",
                    "position": "top",
                    "style": {
                      "fill": "#666"
                    }
                  }
                }
              }
            },
            {
              "type": "TabPane",
              "props": {
                "key": "highPriority",
                "label": "高优先级"
              },
              "component": {
                "type": "Chart",
                "id": "highPriorityProgress",
                "dataSource": {
                  "type": "dataset",
                  "datasetId": "ds_005",
                  "params": {
                    "filter": "type = 'high_priority'",
                    "limit": 100,
                    "outputFields": ["date", "count"]
                  }
                },
                "mockData": [
                  { "date": "周一", "count": 25 },
                  { "date": "周二", "count": 38 },
                  { "date": "周三", "count": 52 },
                  { "date": "周四", "count": 65 },
                  { "date": "周五", "count": 78 },
                  { "date": "周六", "count": 90 },
                  { "date": "周日", "count": 102 }
                ],
                "props": {
                  "chartType": "line",
                  "title": "高优先级职位进度",
                  "xField": "date",
                  "yField": "count",
                  "height": 300,
                  "meta": {
                    "date": { "alias": "日期" },
                    "count": { "alias": "数量" }
                  },
                  "smooth": true
                }
              }
            }
          ]
        }
      ]
    },
