{
  "appConfig": {
    "name": "电商运营工作台",
    "description": "电商行业运营管理平台，包含商品管理、订单处理、库存管理、数据分析等功能",
    "version": "1.0.0",
    "defaultPage": "dashboard",
    "navigation": {
      "mode": "side",
      "items": [
        {
          "key": "dashboard",
          "title": "数据概览",
          "icon": "LayoutDashboard",
          "linkedPage": "dashboard"
        },
        {
          "key": "products",
          "title": "商品管理",
          "icon": "Package",
          "children": [
            {
              "key": "product-list",
              "title": "商品列表",
              "icon": "List",
              "linkedPage": "product-list"
            },
            {
              "key": "product-categories",
              "title": "分类管理",
              "icon": "FolderTree",
              "linkedPage": "product-categories"
            },
            {
              "key": "product-add",
              "title": "添加商品",
              "icon": "Plus",
              "linkedPage": "product-add"
            }
          ]
        },
        {
          "key": "orders",
          "title": "订单管理",
          "icon": "ShoppingCart",
          "children": [
            {
              "key": "order-list",
              "title": "订单列表",
              "icon": "List",
              "linkedPage": "order-list"
            },
            {
              "key": "order-detail",
              "title": "订单详情",
              "icon": "FileText",
              "linkedPage": "order-detail"
            }
          ]
        },
        {
          "key": "inventory",
          "title": "库存管理",
          "icon": "Warehouse",
          "linkedPage": "inventory"
        },
        {
          "key": "customers",
          "title": "客户管理",
          "icon": "Users",
          "linkedPage": "customers"
        },
        {
          "key": "analytics",
          "title": "数据分析",
          "icon": "BarChart3",
          "linkedPage": "analytics"
        }
      ]
    }
  },
  "pages": {
    "dashboard": {
      "title": "数据概览",
      "layout": "fluid",
      "components": [
        {
          "id": "stats",
          "type": "StatisticGroup",
          "props": {
            "grid": {
              "cols": 4
            },
            "items": [
              {
                "key": "today-sales",
                "title": "今日销售额",
                "value": 125680,
                "icon": "DollarSign",
                "trend": {
                  "value": 12.5,
                  "type": "up",
                  "suffix": "%",
                  "status": "success",
                  "description": "较昨日"
                },
                "prefix": "¥"
              },
              {
                "key": "today-orders",
                "title": "今日订单数",
                "value": 342,
                "icon": "ShoppingCart",
                "trend": {
                  "value": 8.3,
                  "type": "up",
                  "suffix": "%",
                  "status": "success",
                  "description": "较昨日"
                }
              },
              {
                "key": "pending-orders",
                "title": "待处理订单",
                "value": 28,
                "icon": "Clock",
                "trend": {
                  "value": 5,
                  "type": "down",
                  "suffix": "",
                  "status": "success",
                  "description": "较昨日"
                }
              },
              {
                "key": "low-stock",
                "title": "低库存商品",
                "value": 15,
                "icon": "AlertTriangle",
                "trend": {
                  "value": 3,
                  "type": "down",
                  "suffix": "",
                  "status": "warning",
                  "description": "较昨日"
                }
              }
            ]
          },
          "useMockData": true
        },
        {
          "id": "sales-chart",
          "type": "Chart",
          "props": {
            "title": "销售趋势",
            "chartType": "line",
            "height": 300
          },
          "mockData": [
            { "date": "2024-01-01", "sales": 120000 },
            { "date": "2024-01-02", "sales": 135000 },
            { "date": "2024-01-03", "sales": 128000 },
            { "date": "2024-01-04", "sales": 142000 },
            { "date": "2024-01-05", "sales": 138000 },
            { "date": "2024-01-06", "sales": 150000 },
            { "date": "2024-01-07", "sales": 145000 }
          ],
          "useMockData": true
        },
        {
          "id": "recent-orders",
          "type": "Table",
          "props": {
            "title": "最近订单",
            "columns": [
              {
                "key": "orderId",
                "title": "订单号",
                "dataIndex": "orderId"
              },
              {
                "key": "customer",
                "title": "客户",
                "dataIndex": "customer"
              },
              {
                "key": "amount",
                "title": "金额",
                "dataIndex": "amount",
                "render": "currency"
              },
              {
                "key": "status",
                "title": "状态",
                "dataIndex": "status",
                "render": "tag"
              },
              {
                "key": "createTime",
                "title": "下单时间",
                "dataIndex": "createTime"
              }
            ],
            "pagination": {
              "pageSize": 10
            }
          },
          "mockData": [
            {
              "orderId": "ORD20240107001",
              "customer": "张三",
              "amount": 299.00,
              "status": "已支付",
              "createTime": "2024-01-07 14:30:00"
            },
            {
              "orderId": "ORD20240107002",
              "customer": "李四",
              "amount": 1580.00,
              "status": "待发货",
              "createTime": "2024-01-07 13:20:00"
            },
            {
              "orderId": "ORD20240107003",
              "customer": "王五",
              "amount": 89.00,
              "status": "已发货",
              "createTime": "2024-01-07 12:15:00"
            }
          ],
          "useMockData": true
        }
      ]
    },
    "product-list": {
      "title": "商品列表",
      "layout": "fluid",
      "components": [
        {
          "id": "product-table",
          "type": "Table",
          "props": {
            "title": "商品列表",
            "columns": [
