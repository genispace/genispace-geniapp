              },
              {
                "title": "状态",
                "dataIndex": "status",
                "key": "status",
                "render": {
                  "type": "Tag",
                  "props": {
                    "color": {
                      "active": "green",
                      "inactive": "default",
                      "pending": "orange"
                    }
