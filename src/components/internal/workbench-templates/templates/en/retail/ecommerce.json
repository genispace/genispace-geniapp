  "pages": {
    "dashboard": {
      "title": "Overview",
      "layout": "fluid",
      "components": [
        {
          "id": "stats",
          "type": "StatisticGroup",
          "props": {
            "grid": {
              "cols": 4
            },
            "items": [
              {
                "key": "today-sales",
                "title": "Sales today",
                "value": 125680,
                "icon": "DollarSign",
                "trend": {
                  "value": 12.5,
                  "type": "up",
                  "suffix": "%",
                  "status": "success",
                  "description": "vs yesterday"
                },
                "prefix": "¥"
              },
              {
                "key": "today-orders",
                "title": "Orders today",
                "value": 342,
                "icon": "ShoppingCart",
                "trend": {
                  "value": 8.3,
                  "type": "up",
                  "suffix": "%",
                  "status": "success",
                  "description": "vs yesterday"
                }
              },
              {
                "key": "pending-orders",
                "title": "Pending orders",
                "value": 28,
                "icon": "Clock",
                "trend": {
                  "value": 5,
                  "type": "down",
                  "suffix": "",
                  "status": "success",
                  "description": "vs yesterday"
                }
              },
              {
                "key": "low-stock",
                "title": "Low-stock SKUs",
                "value": 15,
                "icon": "AlertTriangle",
                "trend": {
                  "value": 3,
                  "type": "down",
                  "suffix": "",
                  "status": "warning",
                  "description": "vs yesterday"
                }
              }
            ]
          },
          "useMockData": true
        },
        {
          "id": "sales-chart",
          "type": "Chart",
          "props": {
            "title": "Sales trend",
            "chartType": "line",
            "height": 300
