{
  "appConfig": {
    "name": "医院管理系统",
    "description": "医疗健康行业管理系统，包含患者管理、预约挂号、病历管理、药品库存等功能",
    "version": "1.0.0",
    "defaultPage": "dashboard",
    "navigation": {
      "mode": "side",
      "items": [
        {
          "key": "dashboard",
          "title": "工作台",
          "icon": "LayoutDashboard",
          "linkedPage": "dashboard"
        },
        {
          "key": "patients",
          "title": "患者管理",
          "icon": "Users",
          "children": [
            {
              "key": "patient-list",
              "title": "患者列表",
              "icon": "List",
              "linkedPage": "patient-list"
            },
            {
              "key": "patient-register",
              "title": "患者登记",
              "icon": "UserPlus",
              "linkedPage": "patient-register"
            }
          ]
        },
        {
          "key": "appointments",
          "title": "预约管理",
          "icon": "Calendar",
          "linkedPage": "appointments"
        },
        {
          "key": "medical-records",
          "title": "病历管理",
          "icon": "FileText",
          "linkedPage": "medical-records"
        },
        {
          "key": "pharmacy",
          "title": "药房管理",
          "icon": "Pill",
          "linkedPage": "pharmacy"
        },
        {
          "key": "doctors",
          "title": "医生管理",
          "icon": "Stethoscope",
          "linkedPage": "doctors"
        }
      ]
    }
  },
  "pages": {
    "dashboard": {
      "title": "工作台",
      "layout": "fluid",
      "components": [
        {
          "id": "stats",
          "type": "StatisticGroup",
          "props": {
            "grid": {
              "cols": 4
            },
            "items": [
              {
                "key": "today-patients",
                "title": "今日接诊",
                "value": 156,
                "icon": "Users",
                "trend": {
                  "value": 8,
                  "type": "up",
                  "suffix": "",
                  "status": "success",
                  "description": "较昨日"
                }
              },
              {
                "key": "today-appointments",
                "title": "今日预约",
                "value": 89,
                "icon": "Calendar",
                "trend": {
                  "value": 5,
                  "type": "up",
                  "suffix": "",
                  "status": "success",
                  "description": "较昨日"
                }
              },
              {
                "key": "pending-appointments",
                "title": "待处理预约",
                "value": 12,
                "icon": "Clock",
                "trend": {
                  "value": 3,
                  "type": "down",
                  "suffix": "",
                  "status": "success",
                  "description": "较昨日"
                }
              },
              {
                "key": "low-medicine",
                "title": "低库存药品",
                "value": 8,
                "icon": "AlertTriangle",
                "trend": {
                  "value": 2,
                  "type": "down",
                  "suffix": "",
                  "status": "warning",
                  "description": "较昨日"
                }
              }
            ]
          },
          "useMockData": true
        },
        {
          "id": "appointment-chart",
          "type": "Chart",
          "props": {
            "title": "预约趋势",
            "chartType": "line",
            "height": 300
          },
          "mockData": [
            { "date": "2024-01-01", "count": 85 },
            { "date": "2024-01-02", "count": 92 },
            { "date": "2024-01-03", "count": 88 },
            { "date": "2024-01-04", "count": 95 },
            { "date": "2024-01-05", "count": 89 },
            { "date": "2024-01-06", "count": 102 },
            { "date": "2024-01-07", "count": 98 }
          ],
          "useMockData": true
        },
        {
          "id": "recent-patients",
          "type": "Table",
          "props": {
            "title": "最近接诊",
            "columns": [
              {
                "key": "patientId",
                "title": "患者ID",
                "dataIndex": "patientId"
              },
              {
                "key": "name",
                "title": "姓名",
                "dataIndex": "name"
              },
              {
                "key": "age",
                "title": "年龄",
                "dataIndex": "age"
              },
              {
                "key": "department",
                "title": "科室",
                "dataIndex": "department"
              },
              {
                "key": "doctor",
                "title": "医生",
                "dataIndex": "doctor"
              },
              {
                "key": "time",
                "title": "就诊时间",
                "dataIndex": "time"
              }
            ],
            "pagination": {
              "pageSize": 10
            }
          },
          "mockData": [
            {
