        {
          "id": "data-table",
          "type": "Table",
          "props": {
            "title": "数据管理",
            "rowKey": "id",
            "showSearch": true,
            "showRefresh": true,
            "addable": true,
            "editable": true,
            "deletable": true,
            "columns": [
              {
                "title": "名称",
