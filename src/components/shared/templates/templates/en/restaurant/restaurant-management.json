  "pages": {
    "dashboard": {
      "title": "Operations overview",
      "layout": "fluid",
      "components": [
        {
          "id": "stats",
          "type": "StatisticGroup",
          "props": {
            "grid": {
              "cols": 4
            },
            "items": [
              {
                "key": "today-revenue",
                "title": "Sales today",
                "value": 12580,
                "icon": "DollarSign",
                "trend": {
                  "value": 15.5,
                  "type": "up",
                  "suffix": "%",
                  "status": "success",
                  "description": "vs yesterday"
                },
                "prefix": "¥"
              },
              {
                "key": "today-orders",
                "title": "Orders today",
                "value": 156,
                "icon": "Receipt",
                "trend": {
                  "value": 8,
                  "type": "up",
                  "suffix": "",
                  "status": "success",
                  "description": "vs yesterday"
                }
              },
              {
                "key": "today-customers",
                "title": "Covers today",
                "value": 342,
                "icon": "Users",
                "trend": {
                  "value": 12,
                  "type": "up",
                  "suffix": "",
                  "status": "success",
                  "description": "vs yesterday"
                }
              },
              {
                "key": "pending-orders",
                "title": "Pending orders",
                "value": 8,
                "icon": "Clock",
                "trend": {
                  "value": 3,
                  "type": "down",
                  "suffix": "",
                  "status": "success",
                  "description": "vs yesterday"
                }
              }
            ]
          },
          "useMockData": true
        },
        {
