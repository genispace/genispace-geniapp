                "prefix": "¥"
              },
              {
                "key": "total-contracts",
                "title": "Total contracts",
                "value": 256,
                "icon": "FileText"
              },
              {
                "key": "active-contracts",
                "title": "Active contracts",
                "value": 189,
                "icon": "CheckCircle"
              }
            ]
          },
          "useMockData": true
        },
        {
          "id": "finance-table",
          "type": "Table",
          "props": {
            "title": "Ledger",
            "columns": [
              {
                "key": "date",
                "title": "Date",
                "dataIndex": "date"
              },
              {
                "key": "type",
                "title": "Type",
                "dataIndex": "type"
              },
              {
                "key": "amount",
