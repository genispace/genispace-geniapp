{
  "appConfig": {
    "name": "餐饮管理系统",
    "description": "餐饮行业管理系统，包含菜品管理、订单管理、库存管理、员工管理等功能",
    "version": "1.0.0",
    "defaultPage": "dashboard",
    "navigation": {
      "mode": "side",
      "items": [
        {
          "key": "dashboard",
          "title": "营业概览",
          "icon": "LayoutDashboard",
          "linkedPage": "dashboard"
        },
        {
          "key": "menu",
          "title": "菜品管理",
          "icon": "Utensils",
          "children": [
            {
              "key": "dish-list",
              "title": "菜品列表",
              "icon": "List",
              "linkedPage": "dish-list"
            },
            {
              "key": "dish-add",
              "title": "添加菜品",
              "icon": "Plus",
              "linkedPage": "dish-add"
            }
          ]
        },
        {
          "key": "orders",
          "title": "订单管理",
          "icon": "Receipt",
          "linkedPage": "orders"
        },
        {
          "key": "inventory",
          "title": "库存管理",
          "icon": "Warehouse",
          "linkedPage": "inventory"
        },
        {
          "key": "staff",
          "title": "员工管理",
          "icon": "Users",
          "linkedPage": "staff"
        },
        {
          "key": "analytics",
          "title": "经营分析",
          "icon": "BarChart3",
          "linkedPage": "analytics"
        }
      ]
    }
  },
  "pages": {
    "dashboard": {
      "title": "营业概览",
      "layout": "fluid",
      "components": [
        {
          "id": "stats",
          "type": "StatisticGroup",
          "props": {
            "grid": {
              "cols": 4
            },
            "items": [
              {
                "key": "today-revenue",
                "title": "今日营业额",
                "value": 12580,
                "icon": "DollarSign",
                "trend": {
                  "value": 15.5,
                  "type": "up",
                  "suffix": "%",
                  "status": "success",
                  "description": "较昨日"
                },
                "prefix": "¥"
              },
              {
                "key": "today-orders",
                "title": "今日订单",
                "value": 156,
                "icon": "Receipt",
                "trend": {
                  "value": 8,
                  "type": "up",
                  "suffix": "",
                  "status": "success",
                  "description": "较昨日"
                }
              },
              {
                "key": "today-customers",
                "title": "今日客流量",
                "value": 342,
                "icon": "Users",
                "trend": {
                  "value": 12,
                  "type": "up",
                  "suffix": "",
                  "status": "success",
                  "description": "较昨日"
                }
              },
              {
                "key": "pending-orders",
                "title": "待处理订单",
                "value": 8,
                "icon": "Clock",
                "trend": {
                  "value": 3,
                  "type": "down",
                  "suffix": "",
                  "status": "success",
                  "description": "较昨日"
                }
              }
            ]
          },
          "useMockData": true
        },
        {
          "id": "revenue-chart",
          "type": "Chart",
          "props": {
            "title": "营业额趋势",
            "chartType": "line",
            "height": 300
          },
          "mockData": [
            { "time": "09:00", "revenue": 1200 },
            { "time": "10:00", "revenue": 1800 },
            { "time": "11:00", "revenue": 2500 },
            { "time": "12:00", "revenue": 3200 },
            { "time": "13:00", "revenue": 2800 },
            { "time": "14:00", "revenue": 1500 },
            { "time": "17:00", "revenue": 2200 },
            { "time": "18:00", "revenue": 3500 },
            { "time": "19:00", "revenue": 4200 },
            { "time": "20:00", "revenue": 3800 }
          ],
          "useMockData": true
        },
        {
          "id": "popular-dishes",
          "type": "Table",
          "props": {
            "title": "热门菜品",
            "columns": [
              {
                "key": "dishName",
                "title": "菜品名称",
                "dataIndex": "dishName"
              },
              {
                "key": "category",
                "title": "分类",
                "dataIndex": "category"
              },
              {
                "key": "sales",
                "title": "今日销量",
                "dataIndex": "sales"
              },
              {
                "key": "revenue",
                "title": "销售额",
                "dataIndex": "revenue",
                "render": "currency"
              }
            ],
            "pagination": {
              "pageSize": 10
            }
          },
          "mockData": [
            {
              "dishName": "宫保鸡丁",
              "category": "川菜",
              "sales": 45,
              "revenue": 2025
            },
            {
              "dishName": "麻婆豆腐",
              "category": "川菜",
              "sales": 38,
              "revenue": 1520
            }
          ],
          "useMockData": true
        }
      ]
    },
    "dish-list": {
      "title": "菜品列表",
      "layout": "fluid",
      "components": [
        {
          "id": "dish-table",
          "type": "Table",
          "props": {
            "title": "菜品列表",
            "columns": [
              {
                "key": "dishId",
                "title": "菜品ID",
                "dataIndex": "dishId"
              },
              {
                "key": "name",
                "title": "菜品名称",
                "dataIndex": "name"
              },
              {
                "key": "category",
                "title": "分类",
                "dataIndex": "category"
              },
              {
                "key": "price",
                "title": "价格",
                "dataIndex": "price",
                "render": "currency"
              },
              {
                "key": "status",
                "title": "状态",
                "dataIndex": "status",
