        {
          "id": "form-desc",
          "type": "Paragraph",
          "props": {
            "content": "以下展示了各种表单组件的使用方式，包括文本输入、选择器、日期选择等。"
          }
        },
        {
          "id": "example-form",
          "type": "Form",
          "props": {
            "title": "示例表单",
            "layout": "vertical",
            "fields": [
              {
                "name": "name",
                "label": "名称",
                "type": "input",
                "required": true,
                "placeholder": "请输入名称"
              },
              {
                "name": "type",
                "label": "类型",
                "type": "select",
                "required": true,
                "options": [
                  { "label": "类型A", "value": "typeA" },
                  { "label": "类型B", "value": "typeB" },
                  { "label": "类型C", "value": "typeC" }
                ]
              },
              {
                "name": "date",
                "label": "日期",
                "type": "date",
                "required": true
              },
              {
                "name": "description",
                "label": "描述",
                "type": "textarea",
                "placeholder": "请输入描述信息"
              },
              {
                "name": "status",
                "label": "状态",
                "type": "radio",
                "options": [
                  { "label": "启用", "value": "active" },
                  { "label": "禁用", "value": "inactive" }
