            {
              "date": "2024-01-05",
              "production": 1380
            },
            {
              "date": "2024-01-06",
              "production": 1500
            },
            {
              "date": "2024-01-07",
              "production": 1450
            }
          ],
          "useMockData": true
        },
        {
          "id": "equipment-status",
          "type": "Table",
          "props": {
            "title": "Equipment status",
            "columns": [
              {
                "key": "equipmentId",
                "title": "Asset ID",
                "dataIndex": "equipmentId"
              },
              {
                "key": "name",
                "title": "Name",
                "dataIndex": "name"
              },
              {
                "key": "status",
                "title": "Status",
                "dataIndex": "status",
                "render": "tag"
              },
              {
                "key": "utilization",
                "title": "Utilization",
                "dataIndex": "utilization",
                "suffix": "%"
              },
              {
                "key": "lastMaintenance",
                "title": "Last PM",
                "dataIndex": "lastMaintenance"
              }
            ],
            "pagination": {
              "pageSize": 10
            }
          },
          "mockData": [
            {
              "equipmentId": "EQ001",
