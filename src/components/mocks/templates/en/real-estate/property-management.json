    "finance": {
      "title": "Finance",
      "layout": "fluid",
      "components": [
        {
          "id": "finance-stats",
          "type": "StatisticGroup",
          "props": {
            "grid": {
              "cols": 4
            },
            "items": [
              {
                "key": "monthly-revenue",
                "title": "Revenue (MTD)",
                "value": 1250000,
                "icon": "DollarSign",
                "prefix": "¥"
              },
              {
                "key": "pending-payment",
                "title": "Receivables",
                "value": 125000,
