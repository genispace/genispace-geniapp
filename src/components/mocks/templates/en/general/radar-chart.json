{
  "appConfig": {
    "name": "Radar Chart Demo Workbench",
    "description": "Demonstrates various use cases of radar chart components",
    "defaultPage": "dashboard",
    "navigation": {
      "mode": "side",
      "items": [
        {
          "key": "dashboard",
          "title": "Dashboard",
          "icon": "Home",
          "linkedPage": "dashboard"
        },
        {
          "key": "skills",
          "title": "Skills Assessment",
          "icon": "Target",
          "linkedPage": "skills"
        },
        {
          "key": "performance",
          "title": "Performance Comparison",
          "icon": "BarChart3",
          "linkedPage": "performance"
        },
        {
          "key": "analysis",
          "title": "Multi-dimensional Analysis",
          "icon": "PieChart",
          "linkedPage": "analysis"
        }
      ]
    }
  },
  "pages": {
    "dashboard": {
      "title": "Radar Chart Demo Dashboard",
      "layout": "fluid",
      "components": [
        {
          "id": "welcome-text",
          "type": "Title",
          "props": {
            "content": "Radar Chart Component Demo"
          }
        },
        {
          "id": "description",
          "type": "Paragraph",
          "props": {
            "content": "This workbench demonstrates various use cases of radar chart components, including skills assessment, performance comparison, and multi-dimensional data analysis."
          }
        },
        {
          "id": "basic-radar",
          "type": "RadarChart",
          "props": {
            "title": "Basic Radar Chart Example",
            "height": 400,
            "angleField": "subject",
            "radiusField": "value",
            "showTooltip": true,
            "showLegend": true,
            "showDataView": true,
            "meta": {
              "value": {
                "alias": "Value",
                "formatter": null
              }
            }
          },
          "mockData": [
            { "subject": "Math", "value": 85 },
            { "subject": "English", "value": 92 },
            { "subject": "Physics", "value": 78 },
            { "subject": "Chemistry", "value": 88 },
            { "subject": "Biology", "value": 90 },
            { "subject": "History", "value": 82 }
          ],
          "useMockData": true
        }
      ]
    },
    "skills": {
      "title": "Skills Assessment Radar Chart",
      "layout": "fluid",
      "components": [
        {
          "id": "skills-title",
          "type": "Title",
          "props": {
            "content": "Skills Assessment Radar Chart"
          }
        },
        {
          "id": "skills-description",
          "type": "Paragraph",
          "props": {
            "content": "Shows the assessment results of different developers across various skills, used for skill comparison and growth planning."
          }
        },
        {
          "id": "skills-radar",
          "type": "RadarChart",
          "props": {
            "title": "Developer Skills Assessment",
            "height": 450,
            "angleField": "skill",
            "radiusField": ["frontend", "backend", "database", "devops"],
            "colors": ["#6B8EBF", "#6FA68C", "#B89A6B", "#C7897D"],
            "fillOpacity": 0.3,
            "strokeWidth": 2,
            "showTooltip": true,
            "showLegend": true,
            "showDataView": true,
            "meta": {
              "frontend": {
                "alias": "Frontend Development",
                "formatter": null
              },
              "backend": {
                "alias": "Backend Development",
                "formatter": null
              },
              "database": {
                "alias": "Database",
                "formatter": null
              },
              "devops": {
                "alias": "DevOps & Deployment",
                "formatter": null
              }
            }
          },
          "mockData": [
            { "skill": "JavaScript", "frontend": 90, "backend": 75, "database": 60, "devops": 45 },
            { "skill": "TypeScript", "frontend": 85, "backend": 80, "database": 50, "devops": 40 },
            { "skill": "React", "frontend": 95, "backend": 60, "database": 45, "devops": 35 },
            { "skill": "Vue", "frontend": 88, "backend": 55, "database": 40, "devops": 30 },
            { "skill": "Node.js", "frontend": 70, "backend": 92, "database": 75, "devops": 80 },
            { "skill": "Python", "frontend": 50, "backend": 85, "database": 90, "devops": 85 },
            { "skill": "Java", "frontend": 40, "backend": 88, "database": 85, "devops": 75 },
            { "skill": "Go", "frontend": 35, "backend": 82, "database": 80, "devops": 90 }
          ],
          "useMockData": true
        }
      ]
    },
    "performance": {
      "title": "Performance Comparison Radar Chart",
      "layout": "fluid",
      "components": [
        {
          "id": "performance-title",
          "type": "Title",
          "props": {
            "content": "Performance Comparison Radar Chart"
          }
        },
        {
          "id": "performance-description",
          "type": "Paragraph",
          "props": {
            "content": "Compare the performance of different products across various metrics to help make product selection decisions."
          }
        },
        {
          "id": "performance-radar",
          "type": "RadarChart",
          "props": {
            "title": "Product Performance Comparison",
            "height": 450,
            "angleField": "metric",
            "radiusField": ["productA", "productB", "productC"],
            "colors": ["#ff6b6b", "#4ecdc4", "#45b7d1"],
            "fillOpacity": 0.2,
            "strokeWidth": 3,
            "showTooltip": true,
            "showLegend": true,
            "showDataView": true,
            "meta": {
              "productA": {
                "alias": "Product A",
                "formatter": null
              },
              "productB": {
                "alias": "Product B",
                "formatter": null
              },
              "productC": {
                "alias": "Product C",
                "formatter": null
              }
            }
          },
          "mockData": [
            { "metric": "Response Speed", "productA": 85, "productB": 92, "productC": 78 },
            { "metric": "Stability", "productA": 90, "productB": 88, "productC": 95 },
            { "metric": "Usability", "productA": 75, "productB": 85, "productC": 82 },
            { "metric": "Feature Completeness", "productA": 88, "productB": 90, "productC": 85 },
            { "metric": "Scalability", "productA": 82, "productB": 78, "productC": 90 },
            { "metric": "Security", "productA": 95, "productB": 88, "productC": 92 },
            { "metric": "Cost-effectiveness", "productA": 80, "productB": 85, "productC": 75 },
            { "metric": "Technical Support", "productA": 88, "productB": 90, "productC": 85 }
          ],
          "useMockData": true
        }
      ]
    },
    "analysis": {
      "title": "Multi-dimensional Analysis Radar Chart",
      "layout": "fluid",
      "components": [
        {
          "id": "analysis-title",
          "type": "Title",
          "props": {
            "content": "Multi-dimensional Analysis Radar Chart"
          }
        },
        {
          "id": "analysis-description",
          "type": "Paragraph",
          "props": {
            "content": "Shows multi-dimensional data analysis in complex business scenarios to help understand relationships between data."
          }
        },
        {
          "id": "analysis-radar",
          "type": "RadarChart",
          "props": {
            "title": "User Behavior Analysis",
            "height": 500,
            "angleField": "dimension",
            "radiusField": ["mobile", "desktop", "tablet"],
            "colors": ["#ff9ff3", "#54a0ff", "#5f27cd"],
            "fillOpacity": 0.25,
            "strokeWidth": 2,
            "showTooltip": true,
            "showLegend": true,
            "showDataView": true,
            "meta": {
              "mobile": {
                "alias": "Mobile",
                "formatter": null
              },
              "desktop": {
                "alias": "Desktop",
                "formatter": null
              },
              "tablet": {
                "alias": "Tablet",
                "formatter": null
              }
            }
          },
          "mockData": [
            { "dimension": "Daily Active Users", "mobile": 120, "desktop": 80, "tablet": 45 },
            { "dimension": "Monthly Active Users", "mobile": 350, "desktop": 220, "tablet": 120 },
            { "dimension": "User Retention Rate", "mobile": 75, "desktop": 85, "tablet": 78 },
            { "dimension": "Average Usage Time", "mobile": 45, "desktop": 120, "tablet": 90 },
            { "dimension": "Conversion Rate", "mobile": 8.5, "desktop": 12.3, "tablet": 9.8 },
            { "dimension": "User Satisfaction", "mobile": 4.2, "desktop": 4.6, "tablet": 4.4 },
            { "dimension": "Feature Usage Rate", "mobile": 85, "desktop": 92, "tablet": 88 },
            { "dimension": "Share Rate", "mobile": 15, "desktop": 8, "tablet": 12 }
          ],
          "useMockData": true
        },
        {
          "id": "simple-radar",
          "type": "RadarChart",
          "props": {
            "title": "Simplified Radar Chart",
            "height": 350,
            "angleField": "category",
            "radiusField": "score",
            "colors": ["#00d2d3"],
            "fillOpacity": 0.4,
            "strokeWidth": 2,
            "showTooltip": true,
            "showLegend": false,
            "showDataView": false,
            "meta": {
              "score": {
                "alias": "Score",
                "formatter": null
              }
            }
          },
          "mockData": [
            { "category": "Innovation", "score": 85 },
            { "category": "Practicality", "score": 92 },
            { "category": "Aesthetics", "score": 78 },
            { "category": "Usability", "score": 88 },
            { "category": "Performance", "score": 90 },
            { "category": "Stability", "score": 82 }
          ],
          "useMockData": true
        }
      ]
    }
  }
}
