{
  "appConfig": {
    "appId": "recruiting-app",
    "logo": "/logo.png",
    "theme": "recruiting",
    "layout": {
      "type": "industry",
      "headerActions": [
        "switchIndustry",
        "userProfile",
        "help"
      ],
      "menuPosition": "mix"
    },
    "navigation": {
      "items": [
        {
          "key": "dashboard",
          "path": "/workbench/recruiting/dashboard",
          "title": "Workbench",
          "icon": "dashboard",
          "linkedPage": "dashboard",
          "pageParameters": {
            "view": "overview",
            "period": "month",
            "showStats": true
          }
        },
        {
          "key": "candidates",
          "path": "/workbench/recruiting/candidates",
          "title": "Candidate search",
          "icon": "search",
          "linkedPage": "candidates",
          "pageParameters": {
            "status": "active",
            "source": "all",
            "pageSize": 20
          }
        },
        {
          "key": "clients",
          "path": "/workbench/recruiting/clients",
          "title": "Clients",
          "icon": "team",
          "linkedPage": "clients",
          "pageParameters": {
            "type": "active",
            "sortBy": "created_at",
            "includeArchived": false
          }
        },
        {
          "key": "jobs",
          "path": "/workbench/recruiting/jobs",
          "title": "Jobs",
          "icon": "solution",
          "linkedPage": "jobs",
          "pageParameters": {
            "status": "open",
            "category": "all",
            "urgency": "high"
          }
        },
        {
          "key": "reports",
          "path": "/workbench/recruiting/reports",
          "title": "Reports",
          "icon": "bar-chart",
          "linkedPage": "reports",
          "pageParameters": {
            "reportType": "recruiting",
            "dateRange": "last_30_days",
            "groupBy": "week",
            "includeSubMetrics": true
          }
        }
      ]
    }
  },
  "pages": {
    "dashboard": {
      "title": "Recruiting workbench",
      "layout": "fluid",
      "components": [
        {
          "type": "StatisticGroup",
          "id": "dashboardStats",
          "grid": {
            "cols": 4
          },
          "dataSource": {
            "type": "dataset",
            "datasetId": "ds_001",
            "params": {
              "filter": "date >= '2024-04-01'",
              "limit": 4,
              "outputFields": [
                "key",
                "title",
                "value",
                "icon",
                "trend"
              ]
            }
          },
          "mockData": [
            {
              "key": "candidates",
              "title": "Candidates today",
              "value": 18,
              "icon": "user",
              "trend": {
                "value": 12,
                "type": "up",
                "suffix": "%",
                "status": "success",
                "description": "vs last week"
              }
            },
            {
              "key": "jobs",
              "title": "Open roles",
              "value": 24,
              "icon": "solution",
              "trend": {
                "value": 5,
                "type": "up",
                "suffix": "",
                "status": "success",
                "description": "new this week"
              }
            },
            {
              "key": "clients",
              "title": "Active clients",
              "value": 12,
              "icon": "team",
              "trend": {
                "value": 8,
                "type": "up",
                "suffix": "%",
                "status": "success",
                "description": "vs last month"
              }
            },
            {
              "key": "hires",
              "title": "Hires (MTD)",
              "value": 6,
              "icon": "check-circle",
              "trend": {
                "value": 3,
                "suffix": "",
                "type": "up",
                "status": "success",
                "description": "Pending confirmation"
              }
            }
          ]
        },
        {
          "type": "Container",
          "id": "listGroup",
          "props": {
            "layout": "grid",
            "cols": [
              1,
              1
            ],
            "gutter": 16
          },
          "children": [
            {
              "type": "DataGridCard",
              "id": "candidateList",
              "props": {
                "title": "Hot candidates",
                "pagination": false,
                "rowKey": "id",
                "columns": [
                  {
                    "title": "Name",
                    "dataIndex": "name",
                    "key": "name",
                    "primary": true,
                    "searchable": true
                  },
                  {
                    "title": "Role",
                    "dataIndex": "position",
                    "key": "position",
                    "secondary": true,
                    "searchable": true
                  },
                  {
                    "title": "Match score",
                    "dataIndex": "matchRate",
                    "key": "matchRate",
                    "render": {
                      "type": "Progress",
                      "props": {
                        "status": "matchRate >= 90 ? 'success' : matchRate >= 70 ? 'normal' : 'exception'",
                        "showInfo": true,
                        "size": "small"
                      }
                    }
                  },
                  {
                    "title": "Status",
                    "dataIndex": "status",
                    "key": "status",
                    "render": {
                      "type": "Tag",
                      "props": {
                        "color": {
                          "interviewing": "blue",
                          "matching": "orange",
                          "offered": "green",
                          "default": "default"
                        }
                      },
                      "text": {
                        "interviewing": "Interviewing",
                        "matching": "Matching",
                        "offered": "Offer out",
                        "default": "Pending"
                      }
                    }
                  }
                ]
              },
              "dataSource": {
                "type": "dataset",
                "datasetId": "ds_002",
                "params": {
                  "filter": "status in ['interviewing', 'matching', 'offered']",
                  "limit": 5,
                  "offset": 0,
                  "outputFields": [
                    "id",
                    "name",
                    "position",
                    "matchRate",
                    "status"
                  ]
                }
              },
              "mockData": [
                {
