  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && vite build && node scripts/copy-assets.mjs && vite build --config vite.standalone.config.ts && node scripts/strip-standalone-fonts.mjs && pnpm check:runtime-dependencies",
    "type-check": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:workbench-parity": "node scripts/check-workbench-parity.mjs",
    "check:sdk-version": "node scripts/check-sdk-version.mjs",
    "check:runtime-dependencies": "node scripts/check-runtime-dependencies.mjs",
    "pack:check": "pnpm check:sdk-version && pnpm build && pnpm pack --pack-destination .pack",
    "prepublishOnly": "pnpm check:sdk-version && pnpm check:workbench-parity && pnpm type-check && pnpm test && pnpm build"
  },
