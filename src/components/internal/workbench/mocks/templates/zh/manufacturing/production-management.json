{
  "appConfig": {
    "name": "生产管理系统",
    "description": "制造业生产管理系统，包含生产计划、设备管理、质量管理、库存管理等功能",
    "version": "1.0.0",
    "defaultPage": "dashboard",
    "navigation": {
      "mode": "side",
      "items": [
        {
          "key": "dashboard",
          "title": "生产概览",
          "icon": "LayoutDashboard",
          "linkedPage": "dashboard"
        },
        {
          "key": "production",
          "title": "生产管理",
          "icon": "Factory",
          "children": [
            {
              "key": "production-plan",
              "title": "生产计划",
              "icon": "Calendar",
              "linkedPage": "production-plan"
            },
            {
              "key": "production-orders",
              "title": "生产订单",
              "icon": "FileText",
              "linkedPage": "production-orders"
            }
          ]
        },
        {
          "key": "equipment",
          "title": "设备管理",
          "icon": "Cog",
          "linkedPage": "equipment"
        },
        {
          "key": "quality",
          "title": "质量管理",
          "icon": "CheckCircle",
          "linkedPage": "quality"
        },
        {
          "key": "inventory",
          "title": "库存管理",
          "icon": "Warehouse",
          "linkedPage": "inventory"
        },
        {
          "key": "analytics",
          "title": "生产分析",
          "icon": "BarChart3",
          "linkedPage": "analytics"
        }
      ]
    }
  },
  "pages": {
    "dashboard": {
      "title": "生产概览",
      "layout": "fluid",
      "components": [
        {
          "id": "stats",
          "type": "StatisticGroup",
          "props": {
            "grid": {
              "cols": 4
            },
            "items": [
              {
                "key": "today-production",
                "title": "今日产量",
                "value": 1250,
                "icon": "Package",
                "trend": {
                  "value": 8.5,
                  "type": "up",
                  "suffix": "%",
                  "status": "success",
                  "description": "较昨日"
                },
                "suffix": "件"
              },
              {
                "key": "production-rate",
                "title": "生产效率",
                "value": 92.5,
                "icon": "TrendingUp",
                "trend": {
                  "value": 2.3,
                  "type": "up",
                  "suffix": "%",
                  "status": "success",
                  "description": "较昨日"
                },
                "suffix": "%"
              },
              {
                "key": "equipment-status",
                "title": "设备运行率",
                "value": 88,
                "icon": "Cog",
                "trend": {
                  "value": 5,
                  "type": "up",
                  "suffix": "%",
                  "status": "success",
                  "description": "较昨日"
                },
                "suffix": "%"
              },
              {
                "key": "defect-rate",
                "title": "不良品率",
                "value": 0.8,
                "icon": "AlertCircle",
                "trend": {
                  "value": 0.2,
                  "type": "down",
                  "suffix": "%",
                  "status": "success",
                  "description": "较昨日"
                },
                "suffix": "%"
              }
            ]
          },
          "useMockData": true
        },
        {
          "id": "production-chart",
          "type": "Chart",
          "props": {
            "title": "产量趋势",
            "chartType": "line",
            "height": 300
          },
          "mockData": [
            { "date": "2024-01-01", "production": 1200 },
            { "date": "2024-01-02", "production": 1350 },
            { "date": "2024-01-03", "production": 1280 },
            { "date": "2024-01-04", "production": 1420 },
            { "date": "2024-01-05", "production": 1380 },
            { "date": "2024-01-06", "production": 1500 },
            { "date": "2024-01-07", "production": 1450 }
          ],
          "useMockData": true
        },
        {
          "id": "equipment-status",
          "type": "Table",
          "props": {
            "title": "设备状态",
            "columns": [
              {
                "key": "equipmentId",
                "title": "设备编号",
                "dataIndex": "equipmentId"
              },
              {
                "key": "name",
                "title": "设备名称",
                "dataIndex": "name"
              },
              {
                "key": "status",
                "title": "状态",
                "dataIndex": "status",
                "render": "tag"
              },
              {
                "key": "utilization",
                "title": "利用率",
                "dataIndex": "utilization",
                "suffix": "%"
              },
              {
                "key": "lastMaintenance",
                "title": "上次维护",
                "dataIndex": "lastMaintenance"
              }
            ],
            "pagination": {
              "pageSize": 10
            }
          },
          "mockData": [
            {
              "equipmentId": "EQ001",
              "name": "注塑机-01",
              "status": "运行中",
              "utilization": 92,
              "lastMaintenance": "2024-01-01"
            }
          ],
          "useMockData": true
        }
      ]
    },
    "production-plan": {
      "title": "生产计划",
      "layout": "fluid",
      "components": [
        {
          "id": "plan-table",
          "type": "Table",
          "props": {
            "title": "生产计划",
            "columns": [
              {
                "key": "planId",
                "title": "计划编号",
                "dataIndex": "planId"
              },
              {
                "key": "product",
                "title": "产品",
                "dataIndex": "product"
              },
              {
                "key": "quantity",
                "title": "计划数量",
                "dataIndex": "quantity"
              },
              {
                "key": "startDate",
                "title": "开始日期",
                "dataIndex": "startDate"
              },
              {
                "key": "endDate",
                "title": "完成日期",
                "dataIndex": "endDate"
              },
              {
                "key": "status",
                "title": "状态",
                "dataIndex": "status",
                "render": "tag"
              }
            ],
            "actions": [
              {
                "key": "add",
                "label": "新建计划",
                "type": "primary",
                "icon": "Plus"
              }
            ],
            "pagination": {
              "pageSize": 20
            }
          },
          "mockData": [
            {
              "planId": "PLAN20240107001",
              "product": "产品A",
              "quantity": 5000,
              "startDate": "2024-01-08",
              "endDate": "2024-01-15",
              "status": "进行中"
            }
          ],
          "useMockData": true
        }
      ]
    },
