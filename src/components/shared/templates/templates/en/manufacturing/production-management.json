{
  "appConfig": {
    "name": "Production Management System",
    "description": "Manufacturing operations: production plans, equipment, quality, and inventory",
    "version": "1.0.0",
    "defaultPage": "dashboard",
    "navigation": {
      "mode": "side",
      "items": [
        {
          "key": "dashboard",
          "title": "Production overview",
          "icon": "LayoutDashboard",
          "linkedPage": "dashboard"
        },
        {
          "key": "production",
          "title": "Production",
          "icon": "Factory",
          "children": [
            {
              "key": "production-plan",
              "title": "Plans",
              "icon": "Calendar",
              "linkedPage": "production-plan"
            },
            {
              "key": "production-orders",
              "title": "Work orders",
              "icon": "FileText",
              "linkedPage": "production-orders"
            }
          ]
        },
        {
          "key": "equipment",
          "title": "Equipment",
          "icon": "Cog",
          "linkedPage": "equipment"
        },
        {
          "key": "quality",
          "title": "Quality",
          "icon": "CheckCircle",
          "linkedPage": "quality"
        },
        {
          "key": "inventory",
          "title": "Inventory",
          "icon": "Warehouse",
          "linkedPage": "inventory"
        },
        {
          "key": "analytics",
          "title": "Analytics",
          "icon": "BarChart3",
          "linkedPage": "analytics"
        }
      ]
    }
  },
  "pages": {
    "dashboard": {
      "title": "Production overview",
      "layout": "fluid",
      "components": [
        {
          "id": "stats",
          "type": "StatisticGroup",
          "props": {
            "grid": {
              "cols": 4
            },
            "items": [
              {
                "key": "today-production",
                "title": "Output today",
                "value": 1250,
                "icon": "Package",
                "trend": {
                  "value": 8.5,
                  "type": "up",
                  "suffix": "%",
                  "status": "success",
                  "description": "vs yesterday"
                },
                "suffix": " pcs"
              },
              {
                "key": "production-rate",
                "title": "Efficiency",
                "value": 92.5,
                "icon": "TrendingUp",
                "trend": {
                  "value": 2.3,
                  "type": "up",
                  "suffix": "%",
                  "status": "success",
                  "description": "vs yesterday"
                },
                "suffix": "%"
              },
              {
                "key": "equipment-status",
                "title": "Asset utilization",
                "value": 88,
                "icon": "Cog",
                "trend": {
                  "value": 5,
                  "type": "up",
                  "suffix": "%",
                  "status": "success",
                  "description": "vs yesterday"
                },
                "suffix": "%"
              },
              {
                "key": "defect-rate",
                "title": "Defect rate",
                "value": 0.8,
                "icon": "AlertCircle",
                "trend": {
                  "value": 0.2,
                  "type": "down",
                  "suffix": "%",
                  "status": "success",
                  "description": "vs yesterday"
                },
                "suffix": "%"
              }
            ]
          },
          "useMockData": true
        },
        {
          "id": "production-chart",
          "type": "Chart",
          "props": {
            "title": "Output trend",
            "chartType": "line",
            "height": 300
          },
          "mockData": [
            {
              "date": "2024-01-01",
              "production": 1200
            },
            {
              "date": "2024-01-02",
              "production": 1350
            },
            {
              "date": "2024-01-03",
              "production": 1280
            },
            {
              "date": "2024-01-04",
              "production": 1420
