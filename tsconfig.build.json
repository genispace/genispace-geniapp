{
  "extends": "./tsconfig.json",
  "include": [
    "src/*.ts",
    "src/*.tsx",
    "src/utils/**/*.ts",
    "src/hooks/**/*.ts",
    "src/hooks/**/*.tsx",
    "src/ai/**/*.ts",
    "src/ai/**/*.tsx",
    "src/storage/**/*.ts",
    "src/storage/**/*.tsx",
    "src/dashboard/**/*.ts",
    "src/dashboard/**/*.tsx",
    "src/case-workspace/**/*.ts",
    "src/case-workspace/**/*.tsx",
    "src/task-workspace/**/*.ts",
    "src/task-workspace/**/*.tsx",
    "src/ui/components/features/app/**/*.ts",
    "src/ui/components/features/app/**/*.tsx",
    "src/ui/components/features/user/UserAvatar.tsx",
    "src/ui/components/features/user/UserDisplay.tsx",
    "src/ui/components/features/user/UserSelect.tsx",
    "src/ui/components/features/user/useUserDirectory.ts",
    "src/ui/components/features/user/userDirectoryTypes.ts",
    "src/ui/components/primitives/page-skeleton/**/*.ts",
    "src/ui/components/primitives/page-skeleton/**/*.tsx",
    "src/ui/components/primitives/feedback/**/*.ts",
    "src/ui/components/primitives/feedback/**/*.tsx",
    "src/ui/components/patterns/form-section.tsx",
    "src/ui/components/ui/**/*.ts",
    "src/ui/components/ui/**/*.tsx",
    "src/ui/hooks/useIsMobile.ts",
    "src/ui/styles/**/*.ts"
  ],
  "exclude": [
    "dist",
    ".pack",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**"
  ]
}
